FROM golang:alpine
WORKDIR /root/project
# C toolchain required to build with CGO_ENABLED=1 (the sqlite driver uses cgo).
RUN apk add --no-cache gcc musl-dev
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -a -v ./cmd/server/main.go

FROM alpine:latest
RUN apk add --no-cache curl ca-certificates && mkdir -p /app
COPY --from=0 /root/project/main /app/configfs-server
RUN chmod +x /app/configfs-server
ENTRYPOINT ["/app/configfs-server"]